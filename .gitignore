# Sensitive config
config.toml

# Dependencies
node_modules/
**/node_modules/

# Rust build artifacts
target/
app/target/

# Remotion & build caches
.cache/
**/.cache/
.remotion/
**/.remotion/

# Job data & exports
jobs/
.deleted-jobs/
exports/
story/out/

# Python caches
__pycache__/

# photos of the job being rendered (copied in by the app, never source)
story/public/img*.png

# owner link lists
*.csv

# the job being rendered: the app writes these before every render (fresh clone: copy them from story/sample/)
story/src/film.json
story/src/episode.json
story/src/lines.json
story/src/custom.tsx
story/public/product.png

# local sample renders and the lemo style contact sheet (large, regenerable; the sheet holds CC BY images)
story-ad/*-sample.mp4
story-ad/*-draft.mp4
story-ad/style-options.jpg
